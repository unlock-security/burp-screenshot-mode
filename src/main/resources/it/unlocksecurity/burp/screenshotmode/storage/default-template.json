{
  "version": 3,
  "templates": [
    {
      "id": "default",
      "name": "Default",
      "settings": {
        "headers": {
          "groups": {
            "caching": "hide",
            "client-hints": "hide",
            "fetch": "hide",
            "general": "hide",
            "infrastructure": "hide",
            "negotiation": "hide",
            "privacy": "hide",
            "reporting": "hide"
          },
          "headers": {}
        },
        "disposition": "horizontal",
        "width": {
          "mode": "full"
        },
        "highlights": [],
        "redactions": [
          {
            "id": "default-redaction-1",
            "regex": "(?<=\\n)(?i:User-Agent): (?<UserAgent>.+)",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[OMITTED]"
          },
          {
            "id": "default-redaction-2",
            "regex": "(?<=\\n)(?i:Cookie): (?<Cookies>.+)",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[OMITTED]"
          },
          {
            "id": "default-redaction-3",
            "regex": "(?<=\\n)(?i:(?:Proxy-)?Authorization): (?:(?<AuthScheme>\\S+) )?(?<AuthParameters>.+)",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              2
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-4",
            "regex": "(?<=\\n)(?i:X-Api-Key|Api-Key|X-Auth-Token|X-Access-Token|X-Amz-Security-Token): (?<Token>.+)",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-5",
            "regex": "[?&](?i:access_token|api_?key|token|signature|sig|X-Amz-Signature|X-Amz-Credential|X-Amz-Security-Token)=(?<Value>[^&\\s#]*)",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-6",
            "regex": "\"(?i:password|passwd|pwd|secret|client_secret)\"\\s*:\\s*\"(?<Value>[^\"]*)\"",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-7",
            "regex": "(?<=[&\\n])(?i:password|passwd|pwd|client_secret)=(?<Value>[^&\\n]*)",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-8",
            "regex": "eyJ[\\w-]+\\.eyJ[\\w-]+\\.[\\w-]*",
            "target": "request",
            "useCaptureGroups": false,
            "selectedGroups": [],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-9",
            "regex": "(?<=\\n)(?i:Set-Cookie): [^=;\\n]+=(?<Value>[^;\\n]*)",
            "target": "response",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-10",
            "regex": "\"(?i:access_token|refresh_token|id_token|token|session_?id|api_?key|secret)\"\\s*:\\s*\"(?<Value>[^\"]*)\"",
            "target": "response",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-11",
            "regex": "eyJ[\\w-]+\\.eyJ[\\w-]+\\.[\\w-]*",
            "target": "response",
            "useCaptureGroups": false,
            "selectedGroups": [],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-12",
            "regex": "[?&](?i:access_token|api_?key|token|signature|sig|X-Amz-Signature|X-Amz-Credential|X-Amz-Security-Token)=(?<Value>[^&\\s#]*)",
            "target": "url",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-13",
            "regex": "eyJ[\\w-]+\\.eyJ[\\w-]+\\.[\\w-]*",
            "target": "url",
            "useCaptureGroups": false,
            "selectedGroups": [],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          }
        ],
        "showTimestamp": false,
        "showResponseInfo": true,
        "theme": "auto",
        "view": "raw",
        "url": "full"
      }
    }
  ],
  "defaultTemplateId": "default"
}
