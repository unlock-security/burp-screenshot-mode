{
  "version": 2,
  "templates": [
    {
      "id": "default",
      "name": "Default",
      "settings": {
        "headersToHide": {
          "both": [
            "Accept",
            "Accept-Encoding",
            "Cache-Control",
            "Content-Digest",
            "Date",
            "Pragma",
            "Priority",
            "Repr-Digest",
            "Via",
            "X-Request-Id"
          ],
          "request": [
            "Accept-Charset",
            "Accept-Language",
            "DNT",
            "Device-Memory",
            "Downlink",
            "DPR",
            "ECT",
            "RTT",
            "Viewport-Width",
            "Early-Data",
            "Purpose",
            "Sec-Browsing-Topics",
            "Sec-CH-Prefers-Color-Scheme",
            "Sec-CH-Prefers-Reduced-Motion",
            "Sec-CH-UA",
            "Sec-CH-UA-Arch",
            "Sec-CH-UA-Bitness",
            "Sec-CH-UA-Form-Factors",
            "Sec-CH-UA-Full-Version",
            "Sec-CH-UA-Full-Version-List",
            "Sec-CH-UA-Mobile",
            "Sec-CH-UA-Model",
            "Sec-CH-UA-Platform",
            "Sec-CH-UA-Platform-Version",
            "Sec-CH-UA-WoW64",
            "Sec-Fetch-Dest",
            "Sec-Fetch-Mode",
            "Sec-Fetch-Site",
            "Sec-Fetch-Storage-Access",
            "Sec-Fetch-User",
            "Sec-GPC",
            "Sec-Purpose",
            "Upgrade-Insecure-Requests"
          ],
          "response": [
            "Accept-CH",
            "Critical-CH",
            "Accept-Ranges",
            "Age",
            "Alt-Svc",
            "Cache-Status",
            "CDN-Cache-Control",
            "CF-Cache-Status",
            "CF-RAY",
            "Cross-Origin-Embedder-Policy",
            "Cross-Origin-Opener-Policy",
            "Cross-Origin-Resource-Policy",
            "X-Duckduckgo-Privacy-Random-Ac",
            "ETag",
            "Expect-CT",
            "Expires",
            "Last-Modified",
            "NEL",
            "Origin-Agent-Cluster",
            "Permissions-Policy",
            "Proxy-Status",
            "Referrer-Policy",
            "Report-To",
            "Reporting-Endpoints",
            "Server-Timing",
            "Timing-Allow-Origin",
            "Strict-Transport-Security",
            "Vary",
            "Warning",
            "X-Amz-Cf-Id",
            "X-Amz-Cf-Pop",
            "X-Amz-Id-2",
            "X-Amz-Request-Id",
            "X-Cache",
            "X-Content-Type-Options",
            "X-DNS-Prefetch-Control",
            "X-Download-Options",
            "X-Frame-Options",
            "X-Permitted-Cross-Domain-Policies",
            "X-Powered-By",
            "X-Served-By",
            "X-Timer",
            "X-XSS-Protection"
          ]
        },
        "disposition": "horizontal",
        "width": {
          "mode": "full"
        },
        "highlights": [],
        "redactions": [
          {
            "id": "default-redaction-1",
            "regex": "(?<=\\n)(?i:User-Agent): (?<UserAgent>.+)",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[OMITTED]"
          },
          {
            "id": "default-redaction-2",
            "regex": "(?<=\\n)(?i:Cookie): (?<Cookies>.+)",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[OMITTED]"
          },
          {
            "id": "default-redaction-3",
            "regex": "(?<=\\n)(?i:(?:Proxy-)?Authorization): (?:(?<AuthScheme>\\S+) )?(?<AuthParameters>.+)",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              2
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-4",
            "regex": "(?<=\\n)(?i:X-Api-Key|Api-Key|X-Auth-Token|X-Access-Token|X-Amz-Security-Token): (?<Token>.+)",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-5",
            "regex": "[?&](?i:access_token|api_?key|token|signature|sig|X-Amz-Signature|X-Amz-Credential|X-Amz-Security-Token)=(?<Value>[^&\\s#]*)",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-6",
            "regex": "\"(?i:password|passwd|pwd|secret|client_secret)\"\\s*:\\s*\"(?<Value>[^\"]*)\"",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-7",
            "regex": "(?<=[&\\n])(?i:password|passwd|pwd|client_secret)=(?<Value>[^&\\n]*)",
            "target": "request",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-8",
            "regex": "eyJ[\\w-]+\\.eyJ[\\w-]+\\.[\\w-]*",
            "target": "request",
            "useCaptureGroups": false,
            "selectedGroups": [],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-9",
            "regex": "(?<=\\n)(?i:Set-Cookie): [^=;\\n]+=(?<Value>[^;\\n]*)",
            "target": "response",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-10",
            "regex": "\"(?i:access_token|refresh_token|id_token|token|session_?id|api_?key|secret)\"\\s*:\\s*\"(?<Value>[^\"]*)\"",
            "target": "response",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-11",
            "regex": "eyJ[\\w-]+\\.eyJ[\\w-]+\\.[\\w-]*",
            "target": "response",
            "useCaptureGroups": false,
            "selectedGroups": [],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-12",
            "regex": "[?&](?i:access_token|api_?key|token|signature|sig|X-Amz-Signature|X-Amz-Credential|X-Amz-Security-Token)=(?<Value>[^&\\s#]*)",
            "target": "url",
            "useCaptureGroups": true,
            "selectedGroups": [
              1
            ],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          },
          {
            "id": "default-redaction-13",
            "regex": "eyJ[\\w-]+\\.eyJ[\\w-]+\\.[\\w-]*",
            "target": "url",
            "useCaptureGroups": false,
            "selectedGroups": [],
            "matchMode": "regex",
            "mode": "replace",
            "replacementText": "[REDACTED]"
          }
        ],
        "showTimestamp": false,
        "showResponseInfo": true,
        "theme": "auto",
        "view": "raw"
      }
    }
  ],
  "defaultTemplateId": "default"
}
