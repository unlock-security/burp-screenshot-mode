{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/exec", { "prepareCmd": "./gradlew jar -PreleaseVersion=${nextRelease.version}" }],
    ["@semantic-release/github", { "assets": [{ "path": "build/libs/screenshot-mode-*.jar" }] }]
  ]
}
